{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vaxresilience:impact-estimate:1.0.0",
  "title": "Synthetic impact estimate",
  "type": "object",
  "required": ["impactEstimateId", "disruptionId", "estimateType", "value", "unit", "method", "inputRefs", "assumptionRefs", "estimateLabel", "calculatedAt", "dataMode", "notPatientOutcome"],
  "properties": {
    "impactEstimateId": { "type": "string", "pattern": "^IMPACT-[A-Z0-9-]+$" },
    "disruptionId": { "type": "string", "pattern": "^DIS-[A-Z0-9-]+$" },
    "estimateType": { "type": "string", "minLength": 1 },
    "value": { "type": "number", "minimum": 0 },
    "unit": { "type": "string", "minLength": 1 },
    "method": { "type": "string", "minLength": 1 },
    "inputRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "assumptionRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "estimateLabel": { "const": "Synthetic estimate; not patient-level data or an actual patient outcome" },
    "calculatedAt": { "type": "string", "format": "date-time" },
    "dataMode": { "enum": ["synthetic", "simulated", "live_verified"] },
    "notPatientOutcome": { "const": true }
  },
  "additionalProperties": false
}
