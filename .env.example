# Placeholder names only. This file does not configure or activate an integration.
# Keep secrets in a verified server-side platform binding/secret facility.

# Application / CAP (safe local demonstration defaults)
APP_ENV=development
APP_PORT=4004
CAP_LOG_LEVEL=info
APP_BASE_PATH=/api/v1

# Data mode: use synthetic fixtures only in a demo environment
DATA_MODE=synthetic
DEMO_DATA_ENABLED=true
DEMO_SCENARIO_ID=BM-PARA-DISRUPTION-2026-10
DEMO_SEED_CONFIRMATION=disabled

# SAP HANA Cloud (provider-dependent; blank until provisioned and verified)
HANA_ENABLED=false
HANA_HOST=
HANA_PORT=
HANA_DATABASE=
HANA_USER=
HANA_PASSWORD=
HANA_CREDENTIALS_BINDING=

# SAP AI Core / Generative AI Hub (provider-dependent; not configured)
AI_ENABLED=false
AI_BASE_URL=
AI_RESOURCE_GROUP=
AI_CLIENT_ID=
AI_CLIENT_SECRET=
AI_AUTH_URL=

# SAP Build Process Automation (provider-dependent; not configured)
WORKFLOW_ENABLED=false
WORKFLOW_BASE_URL=
WORKFLOW_CLIENT_ID=
WORKFLOW_CLIENT_SECRET=
WORKFLOW_CALLBACK_SECRET=

# Voice provider (unselected; not configured)
VOICE_ENABLED=false
VOICE_PROVIDER=
VOICE_BASE_URL=
VOICE_API_KEY=

# Email provider (unselected; not configured)
EMAIL_ENABLED=false
EMAIL_PROVIDER=
EMAIL_BASE_URL=
EMAIL_API_KEY=

# Authentication / authorization (provider and mode require future design)
AUTH_MODE=unconfigured
AUTH_ISSUER_URL=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=

# Feature flags; disabled unless explicitly enabled in a verified environment
FEATURE_AGENT_EXECUTION=false
FEATURE_EXTERNAL_COMMUNICATIONS=false
FEATURE_PROTECTED_ACTION_EXECUTION=false
